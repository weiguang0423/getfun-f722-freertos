# .understandignore — 本仓库知识图谱的排除规则
# 语法同 .gitignore（glob、# 注释、! 取反、尾部 / 表示目录）
# 目标：图谱只聚焦 APP/ 自研应用层，排除第三方/生成/构建/文档/子项目噪声。
#
# 内置默认已排除（无需重复写）：node_modules/ .git/ dist/ build/ obj/
#   *.lock *.min.js 等。下面为针对本仓库显式激活的排除项。

# --- 构建产物（elf/hex/bin/map/rknn 等）---
/build/

# --- 第三方 HAL 驱动（STM32Cube 生成，非业务代码）---
/Drivers/

# --- 第三方中间件（FreeRTOS、STM32 USB 库）---
/Middlewares/

# --- CubeMX 生成的 Cube 应用层（main.c/freertos.c/gpio.c/usbd_cdc_if.c 等）---
/Core/
/USB_DEVICE/

# --- CubeMX 构建配置（cmake 封装，非业务代码）---
/cmake/

# --- CubeMX 工程文件（生成，非代码）---
GETFUN_F722_FreeRTOS.ioc

# --- 启动汇编与链接脚本（构建基础设施）---
startup_stm32f722xx.s
STM32F722XX_FLASH.ld

# --- 开发文档目录（40+ Markdown 计划/验收记录，噪声主要来源）---
/Docs/

# --- RK3568 Linux 伴随计算机子项目（独立技术栈，与固件解耦）---
/Linux/

# --- 临时/工具/历史产物目录 ---
/tmp/
/ELSE/
/Tools/
/ua-run/

# --- 插件自身输出目录 ---
/.understand-anything/

# --- 编辑器 / OS 噪声 ---
.vscode/
.idea/
*.swp

# --- 根目录零散文件（编辑器/工程元数据/临时）---
.clangd
.mxproject
move-src.txt
