    {
      "id": "file:Linux/RK3568/s7_6/s7_6_virtual_rc.cpp",
      "type": "file",
      "name": "s7_6_virtual_rc.cpp",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc.cpp",
      "summary": "实现 S7.6 手势到有界虚拟 RC 的纯逻辑与固定二进制帧。包含 Mapper::update 的保守手势映射、变化率限制、CRC16 线帧编解码以及最小自测,不依赖 RKNN/OpenCV/串口。",
      "tags": ["virtual-rc", "gesture-mapping", "crc16", "rate-limit", "flight-safety"],
      "complexity": "moderate"
    },
    {
      "id": "file:Linux/RK3568/s7_6/s7_6_virtual_rc.hpp",
      "type": "file",
      "name": "s7_6_virtual_rc.hpp",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc.hpp",
      "summary": "S7.6 头文件,定义有界虚拟 RC 的纯逻辑接口:Channels/VirtualRcFrame 结构、Mapper 类、固定 44 字节线帧常量与编解码/自测声明。依赖 s7_5 手势快照类型。",
      "tags": ["header", "virtual-rc", "protocol", "data-structure"],
      "complexity": "simple"
    },
    {
      "id": "file:Linux/RK3568/s7_6/s7_6_virtual_rc_test.cpp",
      "type": "file",
      "name": "s7_6_virtual_rc_test.cpp",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc_test.cpp",
      "summary": "S7.6 最小回归入口,无 RKNN/OpenCV/串口依赖,调用 s7_6::self_test 验证虚拟 RC 映射与帧编解码正确性,失败返回非零。",
      "tags": ["test", "regression", "self-test", "entry-point"],
      "complexity": "simple"
    },
    {
      "id": "class:Linux/RK3568/s7_6/s7_6_virtual_rc.hpp:Mapper",
      "type": "class",
      "name": "Mapper",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc.hpp",
      "summary": "有状态的虚拟 RC 映射器,将 S7.5 ACTIVE 手势快照映射为限速、限幅 RC 通道并产出 VirtualRcFrame。启动或任一失效输入立即释放;不生成 ARM 或总授权 AUX。",
      "tags": ["mapper", "stateful", "gesture", "rate-limit"],
      "complexity": "moderate"
    },
    {
      "id": "function:Linux/RK3568/s7_6/s7_6_virtual_rc.cpp:Mapper::update",
      "type": "function",
      "name": "Mapper::update",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc.cpp",
      "lineRange": [95, 135],
      "summary": "核心映射:校验源新鲜度/序号/ACTIVATE 状态与置信度阈值,将冻结手势映射为目标通道并以固定变化率逼近,失效时立即清零释放。",
      "tags": ["mapper", "gesture", "rate-limit", "safety"],
      "complexity": "moderate"
    },
    {
      "id": "function:Linux/RK3568/s7_6/s7_6_virtual_rc.cpp:encode",
      "type": "function",
      "name": "encode",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc.cpp",
      "lineRange": [137, 157],
      "summary": "将 VirtualRcFrame 序列化为 44 字节固定小端线帧:魔数/版本/有效标志/手势/置信度/序号/心跳/双时间戳/5 通道/CRC16。",
      "tags": ["serialize", "wire-frame", "crc16", "little-endian"],
      "complexity": "simple"
    },
    {
      "id": "function:Linux/RK3568/s7_6/s7_6_virtual_rc.cpp:decode",
      "type": "function",
      "name": "decode",
      "filePath": "Linux/RK3568/s7_6/s7_6_virtual_rc.cpp",
      "lineRange": [159, 198],
      "summary": "解析 44 字节线帧并做完整校验:魔数/版本/CRC16/通道范围/心跳递增/链路超时,有效帧再查序号新鲜度与源超时后输出,非法立即判负。",
      "tags": ["deserialize", "wire-frame", "crc16", "validation"],
      "complexity": "moderate"
    },
    {
