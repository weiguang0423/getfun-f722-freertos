    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_SetPriority",
      "type": "function",
      "name": "__NVIC_SetPriority",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "设置指定 IRQ 的中断优先级（含 NVIC->IP 寄存器写入与内存屏障）。FreeRTOS 与 HAL 在初始化外设中断时调用。",
      "tags": ["cmsis", "nvim", "interrupt", "cortex-m7"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_GetPriority",
      "type": "function",
      "name": "__NVIC_GetPriority",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "读取指定 IRQ 的当前中断优先级，按分组解析抢占/子优先级位域。",
      "tags": ["cmsis", "nvim", "interrupt", "cortex-m7"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_EnableIRQ",
      "type": "function",
      "name": "__NVIC_EnableIRQ",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "置位 NVIC->ISER 使能指定中断线（含 DSB/ISB 屏障保证生效）。",
      "tags": ["cmsis", "nvim", "interrupt", "cortex-m7"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_DisableIRQ",
      "type": "function",
      "name": "__NVIC_DisableIRQ",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "置位 NVIC->ICER 关闭指定中断线，并轮询活跃位确保已停止。",
      "tags": ["cmsis", "nvim", "interrupt", "cortex-m7"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_SetPriorityGrouping",
      "type": "function",
      "name": "__NVIC_SetPriorityGrouping",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "配置 AIRCR PRIGROUP 位域设定抢占/子优先级分组方式。本工程 FreeRTOSConfig 采用固定的 4 位抢占分组。",
      "tags": ["cmsis", "nvim", "priority-grouping", "cortex-m7"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_SystemReset",
      "type": "function",
      "name": "__NVIC_SystemReset",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "触发 AIRCR SYSRESETREQ 请求执行内核软复位。MSP 协议 reboot 命令与参数保存失败时经此路径复位。",
      "tags": ["cmsis", "nvim", "reset", "cortex-m7"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_EnableICache",
      "type": "function",
      "name": "SCB_EnableICache",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "使能 Cortex-M7 指令缓存（SCB->ICIALLU 失效后置位 CCR IC 位）。main.c 启动时调用以加速取指。",
      "tags": ["cmsis", "cortex-m7", "icache", "cache"],
      "complexity": "simple",
      "languageNotes": "仅 Cortex-M7 提供；依赖 SCB->CCR 的 IC 位，需在开启 Cache 前失效整个 I-Cache。"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_EnableDCache",
      "type": "function",
      "name": "SCB_EnableDCache",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "使能 Cortex-M7 数据缓存（初始化并失效 DCache 后置位 CCR DC 位）。main.c 启动时调用。",
      "tags": ["cmsis", "cortex-m7", "dcache", "cache"],
      "complexity": "simple",
      "languageNotes": "开启前需对整片 DCache 做 Clean+Invalidate，否则 DMA 与 CPU 视图不一致；本工程 DMA2 传输 IMU 样本与此强相关。"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_CleanInvalidateDCache_by_Addr",
      "type": "function",
      "name": "SCB_CleanInvalidateDCache_by_Addr",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "按地址区间对 D-Cache 执行 Clean+Invalidate，保证 DMA 缓冲在 CPU 与外设间一致。",
      "tags": ["cmsis", "cortex-m7", "dcache", "cache", "dma-coherency"],
      "complexity": "simple",
      "languageNotes": "DMA 缓冲（如 IMU 14 字节样本缓冲）在 DMA 启动/完成前后需调用此原语维持 cache 一致性。"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_GetFPUType",
      "type": "function",
      "name": "SCB_GetFPUType",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "读取 CPACR 判断 FPU 类型（单精度/双精度），供库代码选择浮点路径。本 MCU 为 FPv5-SP-D16（单精度）。",
      "tags": ["cmsis", "cortex-m7", "fpu"],
      "complexity": "simple"
    }
  ],
