    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_SetPriority",
      "type": "function",
      "name": "__NVIC_SetPriority",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "设置指定 IRQn 的中断优先级（写入 NVIC->IPR 寄存器），FreeRTOS 与 HAL 据此配置中断抢占层级。",
      "tags": ["nvic", "interrupt", "priority", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_GetPriority",
      "type": "function",
      "name": "__NVIC_GetPriority",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "读取指定 IRQn 的中断优先级（从 NVIC->IPR 寄存器），用于优先级查询与调试。",
      "tags": ["nvic", "interrupt", "priority", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:NVIC_EncodePriority",
      "type": "function",
      "name": "NVIC_EncodePriority",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "按给定的优先级分组方案（NVIC_GetPriorityGrouping）将 group/sub 优先级编码为单个 8 位优先级值。",
      "tags": ["nvic", "priority-grouping", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_EnableIRQ",
      "type": "function",
      "name": "__NVIC_EnableIRQ",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "使能指定 IRQ（置位 NVIC->ISER 对应位），例如 DMA、SPI、USART 等外设中断的开启入口。",
      "tags": ["nvic", "interrupt", "enable", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_DisableIRQ",
      "type": "function",
      "name": "__NVIC_DisableIRQ",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "关闭指定 IRQ（置位 NVIC->ICER 对应位），用于临界区或外设去初始化时屏蔽中断。",
      "tags": ["nvic", "interrupt", "disable", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:__NVIC_SystemReset",
      "type": "function",
      "name": "__NVIC_SystemReset",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "通过 SCB->AIRCR 触发处理器系统复位（SYSRESETREQ），MSP 服务器等模块的软件重启请求最终依赖此路径。",
      "tags": ["nvic", "system-reset", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_EnableICache",
      "type": "function",
      "name": "SCB_EnableICache",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "使能 Cortex-M7 指令缓存（ICache），main.c 初始化阶段调用以提升取指性能。",
      "tags": ["scb", "cache", "icache", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_EnableDCache",
      "type": "function",
      "name": "SCB_EnableDCache",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "使能 Cortex-M7 数据缓存（DCache），main.c 初始化阶段调用；需配合按地址范围的缓存清理/失效操作使用。",
      "tags": ["scb", "cache", "dcache", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_CleanDCache_by_Addr",
      "type": "function",
      "name": "SCB_CleanDCache_by_Addr",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "按给定地址范围将 DCache 脏数据回写主存，DMA 传输前/后保证内存与缓存一致性时使用。",
      "tags": ["scb", "cache", "dcache", "dma-coherency", "inline"],
      "complexity": "simple"
    },
    {
      "id": "function:Drivers/CMSIS/Include/core_cm7.h:SCB_GetFPUType",
      "type": "function",
      "name": "SCB_GetFPUType",
      "filePath": "Drivers/CMSIS/Include/core_cm7.h",
      "summary": "检测并返回当前内核的 FPU 类型（FPv5-SP-D16 等），STM32F722 配置下指示单精度 FPU 存在。",
      "tags": ["scb", "fpu", "inline"],
      "complexity": "simple"
    }
