    {
      "id": "file:Linux/RK3568/s7_5/s7_5_gesture.cpp",
      "type": "file",
      "name": "s7_5_gesture.cpp",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.cpp",
      "summary": "实现 S7.5 四类几何手势分类（张掌/握拳/单指/V 字）和五态防抖状态机（NO_HAND/UNKNOWN/CANDIDATE/ACTIVE/RELEASED），用置信度、连续 5 帧、150 ms 确认、250 ms 超时和 300 ms 释放冷却隔离误触发。",
      "tags": ["gesture-recognition", "state-machine", "rk3568", "companion-computer", "s7-5"],
      "complexity": "moderate"
    },
    {
      "id": "file:Linux/RK3568/s7_5/s7_5_gesture.hpp",
      "type": "file",
      "name": "s7_5_gesture.hpp",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.hpp",
      "summary": "S7.5 单手静态手势分类与安全时序状态机的公共接口：定义 GestureId/GestureState 枚举、GestureObservation/GestureSnapshot 结构与 GestureStateMachine 类及 classify/self_test 声明。",
      "tags": ["header", "interface", "gesture-recognition", "rk3568", "s7-5"],
      "complexity": "simple"
    },
    {
      "id": "file:Linux/RK3568/s7_5/s7_5_gesture_test.cpp",
      "type": "file",
      "name": "s7_5_gesture_test.cpp",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture_test.cpp",
      "summary": "S7.5 纯 C++ 最小回归入口，无 RKNN/OpenCV/板端依赖；运行 self_test 并据返回码决定进程退出码，非零表示分类或状态机契约被破坏。",
      "tags": ["test", "regression", "gesture-recognition", "rk3568", "s7-5"],
      "complexity": "simple"
    },
    {
      "id": "class:Linux/RK3568/s7_5/s7_5_gesture.hpp:GestureStateMachine",
      "type": "class",
      "name": "GestureStateMachine",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.hpp",
      "summary": "五态防抖状态机：消费手部有效性、手势观测与时间戳，经连续帧确认后暴露 ACTIVE 活动手势；任何失效输入（无手/低置信/超时/切换）立即清空 active_id。",
      "tags": ["state-machine", "gesture-recognition", "debounce", "safety"],
      "complexity": "moderate"
    },
    {
      "id": "function:Linux/RK3568/s7_5/s7_5_gesture.cpp:classify",
      "type": "function",
      "name": "classify",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.cpp",
      "lineRange": [149, 158],
      "summary": "公开入口：把 21×3 图像坐标与 presence_score 转为几何手势观测，校验有限值并过滤退化手掌后委托 classify_points。",
      "tags": ["gesture-recognition", "entry-point", "validation"],
      "complexity": "simple"
    },
    {
      "id": "function:Linux/RK3568/s7_5/s7_5_gesture.cpp:classify_points",
      "type": "function",
      "name": "classify_points",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.cpp",
      "lineRange": [100, 124],
      "summary": "核心分类器（匿名命名空间内）：按五指伸展度评分张掌/握拳/单指/V 字，取最高分并要求置信度 ≥0.58 且领先余量 ≥0.08，否则返回 UNKNOWN。",
      "tags": ["gesture-recognition", "classifier", "geometry"],
      "complexity": "moderate"
    },
    {
      "id": "function:Linux/RK3568/s7_5/s7_5_gesture.cpp:GestureStateMachine::update",
      "type": "function",
      "name": "GestureStateMachine::update",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.cpp",
      "lineRange": [169, 202],
      "summary": "状态机主循环：基于手部有效性、识别置信度（≥0.75）、超时与帧计数在 NO_HAND/UNKNOWN/CANDIDATE/ACTIVE/RELEASED 间迁移，返回含 active_id 的快照。",
      "tags": ["state-machine", "debounce", "safety"],
      "complexity": "complex"
    },
    {
      "id": "function:Linux/RK3568/s7_5/s7_5_gesture.cpp:self_test",
      "type": "function",
      "name": "self_test",
      "filePath": "Linux/RK3568/s7_5/s7_5_gesture.cpp",
      "lineRange": [204, 234],
      "summary": "确定性自检：用 make_test_hand 验证四类分类正确，并断言状态机在充分帧/时间后进入 ACTIVE、低置信度立即 RELEASED、切换与超时清空活动手势。",
      "tags": ["test", "self-check", "gesture-recognition"],
      "complexity": "moderate"
    },
    {
