    {
      "id": "file:Linux/RK3568/s7_4/README.md",
      "type": "document",
      "name": "README.md (s7_4)",
      "filePath": "Linux/RK3568/s7_4/README.md",
      "summary": "S7.4 摄像头实时手部跟踪说明：把 S7.1 的 IMX335 采集与 S7.3 FP16 两级推理串成实时链，复用 s7_3_board_infer.cpp 并新增 V4L2 MMAP 采集，给出运行、可视化验收、5分钟稳定性关口及板端 DRM 屏显方案。",
      "tags": ["documentation", "rk3568", "companion-computer", "camera-tracking", "acceptance"],
      "complexity": "moderate"
    },
    {
      "id": "file:Linux/RK3568/s7_4/build_board.sh",
      "type": "file",
      "name": "build_board.sh",
      "filePath": "Linux/RK3568/s7_4/build_board.sh",
      "summary": "RK3568 板端交叉构建脚本：用 buildroot aarch64 工具链把 s7_3_board_infer.cpp + s7_4_display.cpp 编译为 s7_4_live，并把 s7_4_drm_smoke.cpp 编译为屏显冒烟程序，依赖 OpenCV 与 RKNN runtime 及 SDK DRM uapi 头。",
      "tags": ["build-system", "shell", "rk3568", "cross-compilation", "verification"],
      "complexity": "simple"
    },
    {
      "id": "file:Linux/RK3568/s7_4/precheck_board.sh",
      "type": "file",
      "name": "precheck_board.sh",
      "filePath": "Linux/RK3568/s7_4/precheck_board.sh",
      "summary": "板端屏显前置条件核验脚本：检查 /dev/dri 设备节点、各 card 状态与可用模式、fbdev、内核 cmdline、drm/dsi 内核日志及运行中的显示合成进程，确认显示屏被内核识别后再进入屏显开发。",
      "tags": ["shell", "rk3568", "verification", "display-pipeline", "companion-computer"],
      "complexity": "simple"
    },
    {
      "id": "file:Linux/RK3568/s7_4/precheck_wsl.sh",
      "type": "file",
      "name": "precheck_wsl.sh",
      "filePath": "Linux/RK3568/s7_4/precheck_wsl.sh",
      "summary": "WSL 主机侧屏显构建前置条件核验脚本：检查 SDK 根目录、内核 uapi DRM 头、libdrm/modetest（可选）、交叉工具链、OpenCV 4.5.5 构建产物与板端部署包是否齐全。",
      "tags": ["shell", "rk3568", "verification", "cross-compilation", "companion-computer"],
      "complexity": "simple"
    },
    {
      "id": "file:Linux/RK3568/s7_4/run_stability.sh",
      "type": "file",
      "name": "run_stability.sh",
      "filePath": "Linux/RK3568/s7_4/run_stability.sh",
      "summary": "S7.4 五分钟实物稳定性运行包裹脚本：保存摄像头配置、启动 s7_4_live 实时推理并每 10 秒采样 RSS/文件描述符/温度/NPU 负载，记录逐帧 JSONL、运行日志与退出码，用于验收 5 分钟稳定性关口。",
      "tags": ["shell", "rk3568", "verification", "acceptance", "stability-test"],
      "complexity": "simple"
    }
