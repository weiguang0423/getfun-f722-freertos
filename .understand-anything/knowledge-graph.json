  "nodes": [
    {
      "id": "module:app-init",
      "type": "module",
      "name": "应用装配",
      "summary": "APP 层入口：创建并初始化所有 RTOS 任务、app_state 与 USB 传输。\n文件: APP/Src/rtos/app_task.c, APP/Inc/rtos/app_task.h",
      "tags": [
        "rtos",
        "init",
        "entry-point"
      ],
      "complexity": "moderate",
      "stage": "support"
    },
    {
      "id": "module:imu-sampling",
      "type": "module",
      "name": "IMU 采样",
      "summary": "ImuTask 是 SPI1/ICM42688P 唯一所有者，1kHz DRDY 门控 DMA 采样原始陀螺/加速度数据。\n文件: APP/Src/rtos/imu_task.c, APP/Inc/rtos/imu_task.h, APP/Src/bsp/imu_bus.c, APP/Inc/bsp/imu_bus.h, APP/Src/drivers/icm42688p.c, APP/Inc/drivers/icm42688p.h",
      "tags": [
        "imu",
        "sensor",
        "dma",
        "task"
      ],
      "complexity": "moderate",
      "stage": "sense"
    },
    {
      "id": "module:time-base",
      "type": "module",
      "name": "时间基准",
      "summary": "Cortex-M7 DWT 微秒时基，提供真实 dt 供采样门控、滤波与姿态积分。\n文件: APP/Src/platform/platform_time.c, APP/Inc/platform/platform_time.h",
      "tags": [
        "platform",
        "time",
        "dwt"
      ],
      "complexity": "moderate",
      "stage": "sense"
    },
    {
      "id": "module:calibration",
      "type": "module",
      "name": "校准",
      "summary": "上电陀螺静态零偏 + 水平单面加速度校准（Welford 窗口），零偏持久化到 Flash。\n文件: APP/Src/algorithms/gyro_calibration.c, APP/Inc/algorithms/gyro_calibration.h, APP/Src/algorithms/accel_calibration.c, APP/Inc/algorithms/accel_calibration.h",
      "tags": [
        "algorithms",
        "calibration",
        "gyro",
        "accel"
      ],
      "complexity": "moderate",
      "stage": "estimate"
    },
    {
      "id": "module:filter",
      "type": "module",
      "name": "低通滤波",
      "summary": "三轴 PT1 低通，按真实 dt 更新（Gyro 100Hz / Accel 30Hz），首样本播种。\n文件: APP/Src/algorithms/imu_filter.c, APP/Inc/algorithms/imu_filter.h",
      "tags": [
        "algorithms",
        "filter",
        "pt1"
      ],
      "complexity": "moderate",
      "stage": "estimate"
    },
    {
      "id": "module:attitude",
      "type": "module",
      "name": "姿态估计",
      "summary": "Mahony 四元数姿态估计，消费滤波后陀螺/加速度，输出姿态四元数。\n文件: APP/Src/algorithms/attitude_estimator.c, APP/Inc/algorithms/attitude_estimator.h",
      "tags": [
        "algorithms",
        "attitude",
        "mahony",
        "quaternion"
      ],
      "complexity": "moderate",
      "stage": "estimate"
    },
    {
      "id": "module:rc-input",
      "type": "module",
      "name": "RC 输入",
      "summary": "CRSF 解析 + Linux 虚拟 RC 监控 + 物理/虚拟 RC 仲裁，产出最终 RC 快照。\n文件: APP/Src/rtos/rc_task.c, APP/Inc/rtos/rc_task.h, APP/Src/bsp/crsf_uart.c, APP/Inc/bsp/crsf_uart.h, APP/Src/protocol/crsf.c, APP/Inc/protocol/crsf.h, APP/Src/bsp/linux_rc_monitor.c, APP/Inc/bsp/linux_rc_monitor.h, APP/Src/algorithms/rc_source_arbiter.c, APP/Inc/algorithms/rc_source_arbiter.h, APP/Src/algorithms/rc_input.c, APP/Inc/algorithms/rc_input.h, APP/Src/algorithms/rc_setpoint.c, APP/Inc/algorithms/rc_setpoint.h",
      "tags": [
        "rc",
        "crsf",
        "arbiter",
        "task"
      ],
      "complexity": "moderate",
      "stage": "control"
    },
    {
      "id": "module:flight-control",
      "type": "module",
      "name": "飞行控制",
      "summary": "ANGLE 外环 + Rate PID + 四态安全链，消费姿态与 RC，产出电机控制量。\n文件: APP/Src/rtos/flight_task.c, APP/Inc/rtos/flight_task.h, APP/Src/algorithms/angle_outer_loop.c, APP/Inc/algorithms/angle_outer_loop.h, APP/Src/algorithms/rate_pid.c, APP/Inc/algorithms/rate_pid.h, APP/Src/algorithms/flight_arming.c, APP/Inc/algorithms/flight_arming.h",
      "tags": [
        "flight",
        "pid",
        "arming",
        "task"
      ],
      "complexity": "moderate",
      "stage": "control"
    },
    {
      "id": "module:mixer",
      "type": "module",
      "name": "混控",
      "summary": "Quad-X 混控，把 4 路控制量映射到 8 路电机端点。\n文件: APP/Src/algorithms/quad_x_mixer.c, APP/Inc/algorithms/quad_x_mixer.h",
      "tags": [
        "mixer",
        "quad-x"
      ],
      "complexity": "moderate",
      "stage": "control"
    },
    {
      "id": "module:motor-output",
      "type": "module",
      "name": "电机输出",
      "summary": "8 路电机安全输出（DShot/GPIO），只有 ARMED 才放行，Failsafe 强制低电平。\n文件: APP/Src/bsp/dshot_motor.c, APP/Inc/bsp/dshot_motor.h",
      "tags": [
        "motor",
        "safety",
        "dshot"
      ],
      "complexity": "moderate",
      "stage": "control"
    },
    {
      "id": "module:msp-usb",
      "type": "module",
      "name": "MSP/USB 通信",
      "summary": "USB CDC 虚拟串口上的 MSP 协议服务器，向 Betaflight Configurator 提供遥测。\n文件: APP/Src/bsp/usb_cdc_transport.c, APP/Inc/bsp/usb_cdc_transport.h, APP/Src/protocol/msp_transport.c, APP/Inc/protocol/msp_transport.h, APP/Src/protocol/msp_server.c, APP/Inc/protocol/msp_server.h",
      "tags": [
        "msp",
        "usb",
        "cdc",
        "protocol"
      ],
      "complexity": "moderate",
      "stage": "interface"
    },
    {
      "id": "module:param-store",
      "type": "module",
      "name": "参数存储",
      "summary": "STM32F722 Sector 6/7 双槽参数存储，保存零偏/PID/Rate/Angle 等配置。\n文件: APP/Src/storage/parameter_store.c, APP/Inc/storage/parameter_store.h",
      "tags": [
        "storage",
        "flash",
        "eeprom"
      ],
      "complexity": "moderate",
      "stage": "interface"
    },
    {
      "id": "module:app-state",
      "type": "module",
      "name": "全局状态",
      "summary": "全局运行态快照（IMU/校准/滤波/姿态/RC/电池），关中断短临界区发布。\n文件: APP/Src/app_state.c, APP/Inc/app_state.h",
      "tags": [
        "state",
        "snapshot",
        "critical-section"
      ],
      "complexity": "moderate",
      "stage": "interface"
    },
    {
      "id": "module:diag",
      "type": "module",
      "name": "平台诊断",
      "summary": "UART4 1Hz 基线诊断与安全停机，致命故障强制电机低电平。\n文件: APP/Src/platform/platform_diag.c, APP/Inc/platform/platform_diag.h",
      "tags": [
        "diag",
        "uart",
        "safety"
      ],
      "complexity": "moderate",
      "stage": "support"
    },
    {
      "id": "module:power",
      "type": "module",
      "name": "电源监测",
      "summary": "ADC3 电源监测 + BatteryTask，发布电池电压/电流到全局状态。\n文件: APP/Src/bsp/power_adc.c, APP/Inc/bsp/power_adc.h, APP/Src/algorithms/power_monitor.c, APP/Inc/algorithms/power_monitor.h, APP/Src/rtos/battery_task.c, APP/Inc/rtos/battery_task.h",
      "tags": [
        "power",
        "adc",
        "battery"
      ],
      "complexity": "moderate",
      "stage": "support"
    }
