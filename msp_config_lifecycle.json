      },
      {
        "id": "write-path",
        "label": "配置/校准写入（私有事务）",
        "focus": ["bf_host", "usb_cdc", "msp_task", "imu_task", "param_store"],
        "note": "SET 只更新 1s 缓存，由 ImuTask 在非 ARMED 且电机 force_safe 后擦写 Sector 6/7 双槽"
      }
    ]
  },
  "participants": [
    { "id": "bf_host", "type": "external", "label": "上位机", "sublabel": "Betaflight GUI" },
    { "id": "usb_cdc", "type": "backend", "label": "USB CDC 传输", "sublabel": "usb_cdc_transport" },
    { "id": "msp_task", "type": "backend", "label": "MspTask", "sublabel": "Idle+2 · 1024w" },
    { "id": "app_state", "type": "database", "label": "app_state", "sublabel": "全局快照" },
    { "id": "imu_task", "type": "backend", "label": "ImuTask", "sublabel": "Idle+4 · 512w" },
    { "id": "param_store", "type": "database", "label": "参数存储", "sublabel": "Sector 6/7 A/B" }
  ],
  "segments": [
    { "from": 160, "to": 342, "label": "状态查询（读路径）" },
    { "from": 352, "to": 516, "label": "配置/校准写入（私有事务）" }
  ],
  "messages": [
    { "from": "bf_host", "to": "usb_cdc", "y": 175, "label": "MSP V1 $M< / V2 $X<", "variant": "emphasis", "note": "CDC_Receive_FS ISR 回调" },
    { "from": "usb_cdc", "to": "msp_task", "y": 205, "label": "1024B 环缓冲 + vTaskNotifyGiveFromISR", "variant": "dashed", "note": "非阻塞唤醒绑定任务" },
    { "from": "msp_task", "to": "app_state", "y": 235, "label": "读快照（IMU/姿态/RC/电池/参数）", "variant": "default" },
    { "from": "app_state", "to": "msp_task", "y": 265, "label": "快照响应数据", "variant": "return" },
    { "from": "msp_task", "to": "usb_cdc", "y": 295, "label": "组包 MSP 回包 + CRC", "variant": "emphasis" },
    { "from": "usb_cdc", "to": "bf_host", "y": 325, "label": "CDC_Transmit_FS 发送", "variant": "return" },

    { "from": "bf_host", "to": "usb_cdc", "y": 358, "label": "MSP SET 配置/校准", "variant": "emphasis" },
    { "from": "usb_cdc", "to": "msp_task", "y": 386, "label": "环缓冲 + 通知", "variant": "dashed" },
    { "from": "msp_task", "to": "app_state", "y": 414, "label": "写参数缓存（1s 事务）", "variant": "default", "note": "不直接擦 Flash" },
    { "from": "msp_task", "to": "imu_task", "y": 442, "label": "imu_task_save_parameters 排队", "variant": "emphasis", "note": "校准同理 request_accel_calibration" },
    { "from": "imu_task", "to": "param_store", "y": 470, "label": "非 ARMED 且 force_safe 后擦写", "variant": "emphasis" },
    { "from": "param_store", "to": "imu_task", "y": 498, "label": "commit 完成 / CRC32", "variant": "return" }
  ],
  "activations": [
    { "participant": "usb_cdc", "from": 169, "to": 331, "type": "backend" },
    { "participant": "msp_task", "from": 199, "to": 331, "type": "backend" },
    { "participant": "app_state", "from": 229, "to": 271, "type": "database" },
    { "participant": "usb_cdc", "from": 352, "to": 392, "type": "backend" },
    { "participant": "msp_task", "from": 380, "to": 448, "type": "backend" },
    { "participant": "app_state", "from": 408, "to": 420, "type": "database" },
    { "participant": "imu_task", "from": 436, "to": 504, "type": "backend" },
    { "participant": "param_store", "from": 464, "to": 504, "type": "database" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "读路径：快照语义",
      "items": [
        "CDC 接收 ISR 只写 1024B 环缓冲并 vTaskNotifyGiveFromISR，绝不在中断上下文阻塞",
        "MspTask 用逐字节状态机解析 MSP V1($M<) / V2($X< + CRC8)，命令派发到 msp_server",
        "读命令只读 app_state 快照（PRIMASK+DMB 短临界区整体拷贝），TX 侧轮询等待 CDC_Transmit_FS 完成"
      ]
    },
    {
      "dot": "rose",
      "title": "写路径：安全事务",
      "items": [
        "MSP SET 只更新 1 秒私有缓存，EEPROM 提交由 ImuTask 排队执行，绝不被 MSP 或诊断直写",
        "ImuTask 在非 ARMED 且电机 force_safe 后才擦写；Sector 6/7 双槽只擦非活动槽，commit 最后写入",
        "配置/校准完成通知回传 MspTask 组包，使上位机看到一致的事务结果"
      ]
    }
  ]
}