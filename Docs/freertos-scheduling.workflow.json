  "cards": [
    {
      "dot": "cyan",
      "title": "任务优先级阶梯",
      "items": [
        "FlightTask (idle+5) > ImuTask (idle+4) > RcTask (idle+3) > MspTask (idle+2) > BatteryTask (idle+1) > InitTask/Idle (idle)",
        "configUSE_PREEMPTION=1：数字越大越先运行，可抢占低优先级任务",
        "configMAX_PRIORITIES=56，tick=1000 Hz，栈溢出检测方法 2，heap_4 15 KB"
      ]
    },
    {
      "dot": "emerald",
      "title": "唤醒与同步机制",
      "items": [
        "直接任务通知唤醒：DMA2→ImuTask、USB CDC→MspTask、USART6→RcTask",
        "周期任务：FlightTask/ImuTask 用 vTaskDelayUntil 1 ms；BatteryTask 20 ms；InitTask 1 s",
        "共享状态用关中断 PRIMASK+DMB 临界区而非互斥量，发布者不阻塞"
      ]
    },
    {
      "dot": "violet",
      "title": "关键约束",
      "items": [
        "ImuTask 是 SPI/DWT/Flash 参数唯一写者，ISR 只捕获 CYCCNT 并发通知",
        "IMU/校准/参数无效时 arming_inhibit_flags 保持置位，FlightTask 拒绝电机输出",
        "FlightTask 与 MspTask 消费 app_state 快照，DShot 仅 ARMED 后映射 motor_idle"
      ]
    }
  ]
