{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "项目开发全流程",
    "locale": "zh-CN",
    "output": "project-methodology.workflow.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
