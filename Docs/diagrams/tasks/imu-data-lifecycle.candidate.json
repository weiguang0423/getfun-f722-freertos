    {
      "dot": "emerald",
      "title": "主链路",
      "items": [
        "DRDY 置位 → SPI DMA 14 B 突发 → 原始字节 + DWT 取时",
        "SI 换算 + CW90 机体系 → 陀螺/加速度扣偏 → PT1 低通 → Mahony 姿态",
        "未滤波校准数据专供 MSP_RAW_IMU；滤波数据供姿态与 FlightTask"
      ]
    },
    {
      "dot": "cyan",
      "title": "采样与时间",
      "items": [
        "ImuTask 1 kHz 轮询 DRDY；ISR 只捕获 CYCCNT 并唤醒，不阻塞",
        "DWT 微秒扩展仅 ImuTask 维护；真实 dt 要求 500–2000 µs",
        "首样本 / dt 越界 / 非有限 → timing_valid=false 并重置管道"
      ]
    },
    {
      "dot": "amber",
      "title": "校准与持久化",
      "items": [
        "陀螺零偏：250 预热 + 2000 Welford，上电重校，不持久化",
        "加速度：水平单面候选，持久化验证成功后才切换；失败保留旧偏置",
        "参数 Flash 仅 ImuTask 在安全态写；ARMED 拒绝擦写 Sector 6/7"
      ]
    },
    {
      "dot": "rose",
      "title": "异常与安全",
      "items": [
        "DMA 超时 abort；连续 3 次错误 → 离线 1 s 后重新初始化",
        "校准窗口被运动 / 非水平 / 方差超限拒绝 → 重启窗口",
        "IMU / 校准 / 时序 / 滤波 / 姿态无效 → arming_inhibit 保持；FlightTask >5 ms 判 stale"
      ]
    }
  ]
