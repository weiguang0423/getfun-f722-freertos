# -----------------------------------------------------------------------------
# GETFUN F722 FreeRTOS - Git ignore rules
# Keep CubeMX inputs, generated source code, startup files, linker scripts,
# middleware sources, CMakeLists.txt, and CMakePresets.json under version control.
# -----------------------------------------------------------------------------

# CMake / Ninja out-of-source build directories
/out/
/RelWithDebInfo/
/MinSizeRel/
/cmake-build-*/
/build/

# Accidental in-source CMake / Ninja output
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/CPackConfig.cmake
/CPackSourceConfig.cmake
/compile_commands.json
/Makefile
/build.ninja
/.ninja_deps
/.ninja_log
/.cmake/

# Compiler and linker output
*.o
*.obj
*.lo
*.d
*.su
*.a
*.lib
*.elf
*.axf
*.out
*.hex
*.bin
*.dfu
*.uf2
*.srec
*.map
*.lst
*.dis
*.sym

# Coverage / profiling output
*.gcda
*.gcno
*.gcov
coverage/

# Python bytecode caches
__pycache__/
*.py[cod]

# RK3568 generated deployment artifacts
/Linux/RK3568/s7_3/s7_3_board_infer
/Linux/RK3568/s7_4/s7_4_live
/Linux/RK3568/s7_5/s7_5_live
/Linux/RK3568/s7_6/s7_6_live
*.rknn

# STM32CubeIDE / Eclipse local workspace state
/.metadata/
/.settings/
/.project
/.cproject
*.launch

# VS Code / CLion / other editor state
/.vscode/
/.idea/
*.code-workspace
*.swp
*.swo
*~

# Debugger and programmer local state / logs
*.jlink
JLinkLog.txt
JLinkSettings.ini
OpenOCD.log
openocd.log
*.svd.patched

# Temporary files and backups
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
*.stackdump
Thumbs.db
Desktop.ini
.DS_Store

# Local scratch output (architecture diagrams, extracted manual pages, host test binaries)
/tmp/
/ELSE/

# Local environment files and secrets
.env
.env.*
!.env.example

# Do not ignore these project-defining files/directories:
# GETFUN_F722_FreeRTOS.ioc
# .mxproject
# CMakeLists.txt
# CMakePresets.json
# cmake/
# Core/
# Drivers/
# Middlewares/
# USB_DEVICE/
# startup_stm32f722xx.s
# STM32F722XX_FLASH.ld
